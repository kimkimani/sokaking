# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Safaricom M-Pesa SDK Credentials (Sandbox / Production)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_ENV="sandbox"

# MySQL Database Connection (XAMPP / Local / Remote)
# Set these to connect your application directly to local XAMPP MySQL or any MySQL database:
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB_NAME="soka_king"
# Alternatively, specify a full connection string:
# MYSQL_URL="mysql://root:@127.0.0.1:3306/soka_king"

# Remote Backend API Configuration
# To connect your Next.js app to your remote PHP backend on cheerplex.co.ke:
BACKEND_URL="https://cheerplex.co.ke/soka_king"
NEXT_PUBLIC_BACKEND_URL="https://cheerplex.co.ke/soka_king"

# SMS Gateway API Configuration (Primary: TextSMS.co.ke)
# Primary SMS Provider: 'textsms' or 'africastalking'
SMS_PRIMARY_PROVIDER="textsms"

# TextSMS.co.ke API Gateway Credentials (https://textsms.co.ke/bulk-sms-api/)
TEXTSMS_PARTNER_ID=""
TEXTSMS_API_KEY=""
TEXTSMS_SHORTCODE="TEXTSMS"

# Africa's Talking SMS API Gateway Credentials (Backup Provider)
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID="SOKAKING"


